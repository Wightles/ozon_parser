# Ozon authorization
OZON_SKUS=2359066702,2829800382
OZON_PHONE=
COOKIES_PATH=cookies.json
OZON_LOGIN_URL=https://www.ozon.ru/
# Optional: connect parsing to an already-authorized local Chrome session.
OZON_CDP_URL=
OZON_HEADLESS=false
OZON_NAVIGATION_TIMEOUT=30
OZON_LOGIN_TIMEOUT=120
OZON_MANUAL_TIMEOUT=300
OZON_HTTP_CONNECT_TIMEOUT=10
OZON_HTTP_READ_TIMEOUT=30
OZON_HTTP_MAX_REDIRECTS=5
OZON_USER_AGENT=

# Gmail API OAuth and verification-message polling
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_OZON_QUERY=from:(ozon.ru)
GMAIL_POLL_INTERVAL=5
GMAIL_TIMEOUT=120
GMAIL_MAX_RESULTS=10

# Parser output
RESULTS_DIR=results
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ozon_parser
POSTGRES_USER=ozon
# Required by Docker Compose; use a strong local value in .env.
POSTGRES_PASSWORD=
# Use `require` for both settings with Neon or another TLS-only provider.
POSTGRES_SSLMODE=prefer
POSTGRES_CHANNEL_BINDING=prefer
